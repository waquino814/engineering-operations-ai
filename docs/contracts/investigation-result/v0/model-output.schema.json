{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://engineering-operations-ai.local/schemas/investigation-result/v0/model-output.schema.json",
  "title": "Investigation model output",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "outcome", "findings", "remediation", "limitations"],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "outcome": {
      "enum": ["completed", "inconclusive"]
    },
    "findings": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "statement",
          "components",
          "confidence",
          "rationale",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,32}$"
          },
          "kind": {
            "enum": ["root_cause", "affected_component", "symptom"]
          },
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "components": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$",
              "maxLength": 64
            }
          },
          "confidence": {
            "enum": ["high", "medium", "low"]
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["file", "line"],
              "properties": {
                "file": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "series": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name", "labels"],
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "labels": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  }
                },
                "samples": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 20,
                  "items": {
                    "type": "array",
                    "prefixItems": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "string"
                      }
                    ],
                    "minItems": 2,
                    "maxItems": 2
                  }
                },
                "time": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "service": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "traceId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{32}$"
                },
                "spanId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{16}$"
                }
              }
            }
          }
        }
      }
    },
    "remediation": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "addresses"],
        "properties": {
          "step": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "addresses": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{1,32}$"
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    }
  }
}
