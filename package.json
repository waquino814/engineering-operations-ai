{
  "name": "engineering-operations-ai",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24 <25"
  },
  "exports": {
    ".": "./src/index.ts",
    "./evaluation": "./src/evaluation/index.ts"
  },
  "scripts": {
    "validate-bundle": "node src/cli.ts validate",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm ui:build",
    "eval:synthetic": "node src/evaluation/cli.ts",
    "eval:suite": "node src/evaluation/suite-cli.ts",
    "fixtures:ui": "node src/evaluation/ui-fixtures.ts > src/ui/fixtures/fixtures.json",
    "dev": "node scripts/dev.ts",
    "serve": "node src/cli.ts serve",
    "demo:seed": "node scripts/seed-demo.ts",
    "ui:dev": "node scripts/dev.ts",
    "ui:vite": "vite",
    "ui:build": "vite build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.0.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
